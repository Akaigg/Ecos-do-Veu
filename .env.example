# Token do bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=
# Application ID (Discord Developer Portal → General Information)
DISCORD_CLIENT_ID=
# Opcional: servidor de testes. Com ele, os comandos são registrados na hora apenas nesse servidor.
DEV_GUILD_ID=
# Caminho do banco SQLite (fonte de verdade do jogo)
DATABASE_PATH=./data/ecos.db
# Intervalo, em segundos, do processo que conclui atividades, filas e missões
JOB_INTERVAL_SECONDS=30
